CREATE OR REPLACE PROCEDURE dm.fill_account_balance_turnover()
LANGUAGE plpgsql
AS $$
BEGIN 

-- 
    WITH corrected_in AS (
        SELECT 
            account_rk,
            effective_date,
            LAG(account_out_sum) OVER(PARTITION BY account_rk ORDER BY effective_date) AS calc_prev_out
        FROM rd.account_balance
    )
    UPDATE rd.account_balance t
    SET account_in_sum = src.calc_prev_out
    FROM corrected_in src
    WHERE t.account_rk = src.account_rk
      AND t.effective_date = src.effective_date
      AND src.calc_prev_out IS NOT NULL 
      AND t.account_in_sum != src.calc_prev_out;

--
    WITH corrected_out AS (
        SELECT 
            account_rk,
            effective_date,
            LEAD(account_in_sum) OVER(PARTITION BY account_rk ORDER BY effective_date) AS calc_next_in
        FROM rd.account_balance
    )
    UPDATE rd.account_balance t
    SET account_out_sum = src.calc_next_in
    FROM corrected_out src
    WHERE t.account_rk = src.account_rk
      AND t.effective_date = src.effective_date
      AND src.calc_next_in IS NOT NULL 
      AND t.account_out_sum != src.calc_next_in;

    TRUNCATE TABLE dm.account_balance_turnover;

    INSERT INTO dm.account_balance_turnover (
        account_rk,
        currency_name,
        department_rk,
        effective_date,
        account_in_sum,
        account_out_sum
    )
    SELECT 
        a.account_rk,
        COALESCE(dc.currency_name, '-1'::TEXT) AS currency_name,
        a.department_rk,
        ab.effective_date,
        ab.account_in_sum,
        ab.account_out_sum
    FROM rd.account a
    LEFT JOIN rd.account_balance ab ON a.account_rk = ab.account_rk
    LEFT JOIN dm.dict_currency dc ON a.currency_cd = dc.currency_cd;

END;
$$;
