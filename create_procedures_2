--проверка дубликатов
SELECT 
    client_rk, 
    effective_from_date, 
    COUNT(*) AS count_duplicates
FROM dm.client
GROUP BY client_rk, effective_from_date
HAVING COUNT(*) > 1
ORDER BY count_duplicates DESC;

CREATE OR REPLACE PROCEDURE dm.delete_client_duplicates()
LANGUAGE plpgsql
AS $$
BEGIN
    DELETE FROM dm.client c
    USING (
        SELECT client_rk, effective_from_date, MIN(ctid) as min_ctid
        FROM dm.client
        GROUP BY client_rk, effective_from_date
        HAVING COUNT(*) > 1 
    ) t
    WHERE c.client_rk = t.client_rk 
      AND c.effective_from_date = t.effective_from_date
      AND c.ctid <> t.min_ctid;
      
END;
$$;

